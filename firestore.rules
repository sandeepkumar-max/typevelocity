rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidTypingSession(data) {
      return data.keys().hasAll(['userId', 'mode', 'wpm', 'accuracy', 'timeSpent', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.mode is string && data.mode in ['practice', 'sprint', 'meteor'] &&
             data.wpm is number &&
             data.accuracy is number &&
             data.timeSpent is number &&
             data.createdAt == request.time &&
             (data.get('errorCount', 0) is number) &&
             (data.get('backspaceCount', 0) is number);
    }

    match /users/{userId}/sessions/{sessionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidTypingSession(request.resource.data);
      allow update, delete: if false; // Sessions are immutable
    }
  }
}
